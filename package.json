{
  "name": "angular-testing-course",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "postinstall": "npm --prefix react-app install",
    "server": "ts-node -P ./server/server.tsconfig.json ./server/server.ts",
    "start": "npm --prefix react-app run dev",
    "dev": "run-p server start",
    "build": "npm --prefix react-app run build",
    "test": "npm --prefix react-app run test",
    "lint": "npm --prefix react-app run lint",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "build:prod": "npm --prefix react-app run build",
    "start:prod": "npm --prefix react-app run preview",
    "build-and-start:prod": "run-s build:prod start:prod",
    "e2e": "start-server-and-test build-and-start:prod http://localhost:4200 cypress:run"
  },
  "private": true,
  "dependencies": {
    "body-parser": "^1.18.3",
    "cors": "^2.8.5",
    "express": "^4.16.2"
  },
  "devDependencies": {
    "@types/express": "^4.0.39",
    "@types/node": "^20.17.10",
    "cypress": "^13.17.0",
    "npm-run-all": "^4.1.5",
    "start-server-and-test": "^1.9.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  }
}
